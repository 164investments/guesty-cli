{
  "name": "guesty-cli",
  "version": "1.2.1",
  "description": "CLI for the Guesty property management API with read-only cached-token authentication and rate limiting",
  "type": "module",
  "bin": {
    "guesty": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "RELEASE_NOTES.md",
    "docs/api-audit-2026-09-07.md",
    "docs/endpoint-tests-2026-09-07.md",
    "api-spec.json",
    "openapi-spec.json",
    "guesty-cli-spec.json",
    "booking-engine-api-spec.json",
    "booking-engine-openapi-spec.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -v | grep 'Version 7' && tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run check:cli-spec",
    "check:cli-spec": "node scripts/generate-cli-spec.mjs --check",
    "generate:cli-spec": "node scripts/generate-cli-spec.mjs",
    "link": "npm run build && npm link",
    "refresh:api-spec": "node scripts/refresh-api-spec.mjs",
    "refresh:booking-engine-spec": "node scripts/refresh-api-spec.mjs --booking-engine",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "guesty",
    "property-management",
    "vacation-rental",
    "cli",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/164investments/guesty-cli.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
