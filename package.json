{
  "name": "guesty-cli",
  "version": "2.0.0",
  "description": "CLI and MCP server for the Guesty Open API and Booking Engine API, with read-only cached-token authentication and rate limiting",
  "type": "module",
  "bin": {
    "guesty": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/cli.js",
    "dist/guesty-*",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "docs/api-audit-2026-09-07.md",
    "docs/endpoint-tests-2026-09-07.md",
    "docs/endpoint-coverage-2026-10-21.md",
    "api-spec.json",
    "openapi-spec.json",
    "guesty-cli-spec.json",
    "booking-engine-api-spec.json",
    "booking-engine-openapi-spec.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsrs --version && tsrs --noEmit",
    "check": "npm run typecheck && npm test && npm run check:cli-spec",
    "check:cli-spec": "node scripts/generate-cli-spec.mjs --check",
    "check:server": "npm run build && npm --prefix server run check",
    "generate:cli-spec": "node scripts/generate-cli-spec.mjs",
    "link": "npm run build && npm link",
    "refresh:api-spec": "node scripts/refresh-api-spec.mjs",
    "refresh:booking-engine-spec": "node scripts/refresh-api-spec.mjs --booking-engine",
    "docs:watch": "node scripts/docs-watch.mjs",
    "pack": "node scripts/pack.mjs",
    "smoke:install": "node scripts/smoke-install.mjs"
  },
  "keywords": [
    "guesty",
    "property-management",
    "vacation-rental",
    "cli",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/164investments/guesty-cli.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
